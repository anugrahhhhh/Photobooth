PORT=3000
DB_PATH=./data/photobooth.db
UPLOAD_DIR=./uploads
SESSION_SECRET=ganti-dengan-string-acak-panjang
TZ=Asia/Jakarta
# Alamat publik booth untuk QR dan tautan email/WhatsApp (http/https, tanpa path).
# Wajib di produksi bila email atau WhatsApp aktif. Di Fly: fly secrets set PUBLIC_URL=https://photobooth-anugrah.fly.dev
PUBLIC_URL=
# Batas total kiriman email + WhatsApp per 24 jam (bawaan 400, di bawah batas Gmail ~500/hari)
MAX_DELIVERIES_PER_DAY=
NODE_ENV=development
# Opsional: membuat admin pertama saat database belum punya user (berguna di hosting tanpa terminal)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email hasil foto (SMTP). Kosongkan salah satu untuk menonaktifkan pengiriman email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opsional: pengirim yang tampil; bawaan SMTP_USER
SMTP_FROM=
# Isi "json" untuk uji lokal tanpa SMTP (email tidak benar-benar terkirim)
MAIL_TRANSPORT=

# WhatsApp Cloud API (template bergambar). Kosongkan salah satu untuk menonaktifkan
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Nama template yang disetujui Meta (header gambar + satu parameter body berisi tautan)
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=id
# Opsional: basis URL API; bawaan https://graph.facebook.com/v21.0
WA_API_BASE=
